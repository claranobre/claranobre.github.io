---
import ArticleArt from './ArticleArt.astro';
import CornerCard from './CornerCard.astro';
import { withBase } from '../utils/paths';

interface Props { title: string }
const { title } = Astro.props;
---

<div class="article-title-card">
  <CornerCard mask>
    <ArticleArt {title} />
    <span slot="corner" class="article-mark" aria-hidden="true"><img src={withBase('cerejeira.svg')} width="26" height="26" alt="" /></span>
  </CornerCard>
</div>

<style>
  .article-title-card :global(.article-art) { padding-inline-end: max(56px, 12%); }
  .article-mark {
    width: 43px;
    height: 43px;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--area);
  }
</style>
