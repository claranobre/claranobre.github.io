---
import { site } from '../site.config';
import { withBase } from '../utils/paths';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { label: 'Blog', href: withBase('blog/'), icon: 'blog' },
  { label: 'Sobre', href: withBase('about/'), icon: 'about' },
] as const;
const path = Astro.url.pathname;
const home = withBase();
const topics = withBase('tags/');
const logo = withBase('cerejeira.svg');
---

<header class="site-header" data-site-header>
  <button type="button" class="nav-dock nav-launch" data-nav-launch aria-label="Abrir menu" aria-expanded="false" aria-controls="site-navigation" hidden>
    <img class="blossom-mark" src={logo} width="31" height="31" alt="" />
  </button>
  <nav class="nav-dock site-nav" id="site-navigation" aria-label="Navegação principal">
    <a class="nav-brand" href={home} aria-label={site.title + ', início'} aria-current={path === home ? 'page' : undefined}>
      <img class="blossom-mark" src={logo} width="27" height="27" alt="" />
      <span class="wordmark">{site.wordmark}</span>
    </a>
    {links.map(({ href, icon, label }) => (
      <a class="nav-link" href={href} aria-label={label} aria-current={path === href ? 'page' : path.startsWith(href) ? 'location' : undefined}>
        <Icon name={icon} /><span class="nav-label">{label}</span>
      </a>
    ))}
    <details class="nav-more">
      <summary class="nav-link" aria-label="Mais opções">
        <Icon name="more" /><span class="nav-label">Mais</span>
      </summary>
      <div class="nav-panel">
        <a href={topics} aria-current={path === topics ? 'page' : path.startsWith(topics) ? 'location' : undefined}>Assuntos</a>
        <a href={withBase('rss.xml')}><Icon name="rss" /> RSS</a>
        <ThemeToggle />
      </div>
    </details>
    <button type="button" class="nav-link nav-close" data-nav-close aria-label="Fechar menu" hidden><Icon name="close" size={18} /></button>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const launch = header?.querySelector<HTMLButtonElement>('[data-nav-launch]');
  const close = header?.querySelector<HTMLButtonElement>('[data-nav-close]');
  const firstLink = header?.querySelector<HTMLAnchorElement>('.nav-brand');
  const more = header?.querySelector<HTMLDetailsElement>('.nav-more');

  if (header && launch && close && firstLink && more) {
    const dock = header;
    const launchButton = launch;
    const closeButton = close;
    const first = firstLink;
    const moreMenu = more;
    const compact = matchMedia('(max-width: 760px), (pointer: coarse), (max-width: 1024px) and (max-height: 540px)');

    dock.dataset.enhanced = '';
    launch.hidden = false;
    close.hidden = false;

    function setOpen(open: boolean, restoreFocus = false) {
      dock.toggleAttribute('data-open', open);
      launchButton.setAttribute('aria-expanded', String(open));
      if (!open) moreMenu.open = false;
      if (open) first.focus({ preventScroll: true });
      if (restoreFocus) launchButton.focus({ preventScroll: true });
    }

    launchButton.addEventListener('click', () => setOpen(true));
    closeButton.addEventListener('click', () => setOpen(false, true));
    compact.addEventListener('change', () => {
      const active = document.activeElement;
      setOpen(false, compact.matches && dock.contains(active));
      if (!compact.matches && active === launchButton) first.focus({ preventScroll: true });
    });

    function dismissOutside(event: Event) {
      if (!(event.target instanceof Node)) return;
      if (!moreMenu.contains(event.target)) moreMenu.open = false;
      if (!dock.contains(event.target) && dock.hasAttribute('data-open')) {
        setOpen(false);
      }
    }

    document.addEventListener('pointerdown', dismissOutside);
    document.addEventListener('focusin', dismissOutside);
    dock.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      if (moreMenu.open) {
        event.preventDefault();
        moreMenu.open = false;
        moreMenu.querySelector('summary')?.focus({ preventScroll: true });
      } else if (dock.hasAttribute('data-open') && compact.matches) {
        event.preventDefault();
        setOpen(false, true);
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 18px;
    z-index: 25;
    overflow-anchor: none;
    display: flex;
    justify-content: center;
    margin-top: 22px;
    padding-inline: 12px;
    pointer-events: none;
  }
  .nav-dock {
    position: relative;
    display: flex;
    align-items: center;
    padding: 4px;
    gap: 3px;
    max-width: 100%;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--panel) 94%, transparent);
    backdrop-filter: blur(12px);
    box-shadow: 0 8px 24px #35182b12;
    pointer-events: auto;
  }
  .nav-brand, .nav-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 44px;
    padding: 0 17px;
    border-radius: 999px;
    color: var(--muted);
    font-size: 14px;
    text-decoration: none;
    white-space: nowrap;
    touch-action: manipulation;
  }
  .nav-brand { padding: 0 13px; }
  .blossom-mark { flex: none; }
  .wordmark { color: var(--ink); font: 400 1.35rem/1 var(--serif); letter-spacing: -.03em; }
  .nav-launch, .nav-close { display: none; }
  .nav-link:is(:hover, [aria-current]), .nav-brand:is(:hover, [aria-current]), .nav-more:is([open], :has([aria-current])) summary {
    background: var(--area);
    color: var(--accent);
  }
  .nav-more summary { cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .nav-panel {
    position: absolute;
    inset: calc(100% + 10px) 0 auto auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: min(235px, calc(100vw - 32px));
    max-block-size: calc(100dvh - 96px);
    overflow: auto;
    overscroll-behavior: contain;
    padding: 8px;
    border: 1px solid var(--line);
    border-radius: var(--radius-panel);
    background: var(--panel);
    box-shadow: 0 10px 35px #0003;
  }
  .nav-more:not([open]) > .nav-panel { display: none; }
  .nav-panel > :global(:is(a, button)) {
    display: flex;
    align-items: center;
    gap: 6px;
    padding-inline: 12px;
    min-height: 44px;
    border-radius: var(--radius-control);
    font-size: var(--text-supporting);
    text-decoration: none;
  }
  .nav-panel > :global(button) { grid-column: 1 / -1; }
  .nav-panel > :global(:is(a, button):is(:hover, :focus-visible, [aria-current])) { background: var(--area); color: var(--accent); }

  @media (max-width: 760px), (pointer: coarse), (max-width: 1024px) and (max-height: 540px) {
    :global(html) { scroll-padding-bottom: calc(75px + env(safe-area-inset-bottom)); }
    :global(body) { padding-bottom: calc(70px + env(safe-area-inset-bottom)); }
    .site-header {
      --nav-bottom: max(12px, env(safe-area-inset-bottom));
      position: fixed;
      inset: auto 0 var(--nav-bottom);
      margin: 0;
    }
    .nav-dock { gap: 2px; padding: 3px; }
    .nav-brand, .nav-link { width: 44px; padding: 0; }
    .wordmark, .nav-label { display: none; }
    .nav-panel {
      inset: auto 0 calc(100% + 10px) auto;
      max-block-size: calc(100dvh - var(--nav-bottom) - 64px - max(8px, env(safe-area-inset-top)));
    }
    .site-header[data-enhanced]:not([data-open]) { justify-content: flex-end; }
    [data-enhanced]:not([data-open]) .site-nav { display: none; }
    [data-enhanced]:not([data-open]) .nav-launch {
      display: flex;
      width: 52px;
      height: 52px;
      justify-content: center;
    }
    [data-open] .nav-close { display: flex; }
  }
</style>
