<button class="theme-toggle" type="button" hidden>Tema escuro</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const root = document.documentElement;

  if (button) {
    const control = button;
    const updateLabel = () => {
      control.textContent = root.dataset.theme === 'dark' ? 'Tema claro' : 'Tema escuro';
    };

    updateLabel();
    control.hidden = false;
    control.addEventListener('click', () => {
      const theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = theme;
      updateLabel();
      try {
        localStorage.setItem('clara-theme', theme);
      } catch {
        // O tema também funciona sem armazenamento local.
      }
    });
  }
</script>
