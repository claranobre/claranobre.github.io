---
interface Props {
  name: 'arrow' | 'left' | 'diagonal' | 'blog' | 'projects' | 'about' | 'more' | 'menu' | 'close' | 'chevron' | 'rss' | 'search' | 'calendar' | 'words' | 'clock' | 'linkedin' | 'github' | 'flickr';
  size?: number;
}
const { name, size = 16 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'arrow' && <path d="M4 12h15m-6-6 6 6-6 6" />}
  {name === 'left' && <path d="M20 12H5m6 6-6-6 6-6" />}
  {name === 'diagonal' && <path d="M6 18 18 6M7 6h11v11" />}
  {name === 'blog' && <path d="M6 3.5h9l3 3V21H6zM14.5 3.5v4H18M9 11h6m-6 4h6" />}
  {name === 'projects' && <path d="M3 6h6l2 2h10v11H3z" />}
  {name === 'about' && <><circle cx="12" cy="8" r="3.5" /><path d="M5 20v-1.8a7 7 0 0 1 14 0V20" /></>}
  {name === 'more' && <><circle cx="5" cy="12" r="1" /><circle cx="12" cy="12" r="1" /><circle cx="19" cy="12" r="1" /></>}
  {name === 'menu' && <path d="M4 6h16M4 12h16M4 18h16" />}
  {name === 'close' && <path d="m6 6 12 12M18 6 6 18" />}
  {name === 'chevron' && <path d="m6 9 6 6 6-6" />}
  {name === 'rss' && <><circle cx="5.5" cy="18.5" r="1.5" stroke="none" fill="currentColor" /><path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16" /></>}
  {name === 'calendar' && <path d="M4 6h16v14H4zM8 4v4m8-4v4M4 10h16" />}
  {name === 'words' && <path d="M5 6h14M5 12h14M5 18h9" />}
  {name === 'clock' && <><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></>}
  {name === 'linkedin' && <><rect x="3" y="3" width="18" height="18" rx="3" /><path d="M8 11v5m0-8h.01M12 16v-5m0 2a2 2 0 0 1 4 0v3" /></>}
  {name === 'github' && <path d="M9 19c-4.3 1.3-4.3-2-6-2.5M15 21v-3.4a3 3 0 0 0-.8-2.3C17 15 20 14 20 9.5a4.3 4.3 0 0 0-1.2-3c.3-1 .3-2.1-.1-3.1 0 0-1-.3-3.2 1.2a12 12 0 0 0-6 0C7.3 3.1 6.3 3.4 6.3 3.4c-.4 1-.4 2.1-.1 3.1a4.3 4.3 0 0 0-1.2 3c0 4.5 3 5.5 5.8 5.8a3 3 0 0 0-.8 2.3V21" />}
  {name === 'flickr' && <g fill="currentColor" stroke="none"><circle cx="6.5" cy="12" r="4.5" /><circle cx="17.5" cy="12" r="4.5" /></g>}
  {name === 'search' && <><circle cx="10.8" cy="10.8" r="5.8" /><path d="m15.2 15.2 4.3 4.3" /></>}
</svg>
