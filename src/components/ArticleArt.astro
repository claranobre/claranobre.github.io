---
import Chip from './Chip.astro';
import { articleColors } from '../lib/article-colors';
import { splitArticleTitle } from '../lib/article-title';
import { asciiBackgroundScene } from '../lib/ascii-background';

interface Props { title: string; as?: 'h1' | 'h2' | 'h3'; topic?: string }
const { title, as: Heading = 'h1', topic } = Astro.props;
const { tone, text } = await asciiBackgroundScene(title);
const { light, dark } = articleColors[tone];
const { prefix, suffix } = splitArticleTitle(title);
---

<div class:list={['article-art', { 'featured-art': Heading !== 'h1' }]} data-tone={tone} style={{
  '--art-surface-light': light.surface,
  '--art-ink-light': light.ink,
  '--art-accent-light': light.accent,
  '--art-surface-dark': dark.surface,
  '--art-ink-dark': dark.ink,
  '--art-accent-dark': dark.accent,
}}>
  <div class="art-text" aria-hidden="true"><pre set:text={text} /></div>
  <Heading>{prefix}{suffix && <>{' '}<span class="title-accent">{suffix}</span></>}</Heading>
  {topic && <div class="featured-topic"><Chip>{topic}</Chip></div>}
</div>

<style>
  .article-art {
    --art-surface: var(--art-surface-light);
    --art-ink: var(--art-ink-light);
    --art-accent: var(--art-accent-light);
    position: relative;
    isolation: isolate;
    padding: clamp(18px, 3vw, 28px);
    background: var(--art-surface);
    color: var(--art-ink);
    overflow: clip;
  }
  :global(html[data-theme='dark']) .article-art {
    --art-surface: var(--art-surface-dark);
    --art-ink: var(--art-ink-dark);
    --art-accent: var(--art-accent-dark);
  }
  .article-art :is(h1, h2, h3) { color: inherit; overflow-wrap: anywhere; text-wrap: wrap; }
  .article-art h1 {
    font: 520 clamp(32px, 5vw, 48px)/1.05 var(--sans);
    letter-spacing: -.04em;
  }
  h1 .title-accent { display: block; }
  .title-accent { font-family: var(--serif); font-weight: 400; color: var(--art-accent); }
  .art-text {
    position: absolute;
    z-index: -1;
    inset-block: 0;
    inset-inline-end: 0;
    inline-size: min(72%, 22.5rem);
    container-type: inline-size;
    overflow: clip;
    mask-image: linear-gradient(to right, transparent, #000 56%);
    pointer-events: none;
    user-select: none;
  }
  pre {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-end: 0;
    transform: translateY(-50%);
    margin: 0;
    color: var(--art-accent);
    opacity: .46;
    font: clamp(.44rem, 2.75cqi, .625rem)/1 var(--mono);
    letter-spacing: 0;
  }
  .featured-art { display: flex; flex-direction: column; flex: 1; min-height: 144px; padding: 14px 20px 12px; }
  .featured-art :is(h2, h3) { margin: auto 0; font: 400 clamp(24px, 3vw, 33px)/1.08 var(--serif); letter-spacing: -.038em; }
  .featured-topic { padding-top: 10px; --ink: var(--art-ink); --line: color-mix(in srgb, var(--art-ink) 38%, var(--art-surface)); }

  @media (max-width: 760px) {
    pre { opacity: .27; }
  }
  @media print, (forced-colors: active) {
    .art-text { display: none; }
    .article-art { background: transparent; color: var(--ink); }
    .title-accent { color: inherit; }
  }
</style>
