---
import ArticleArt from '../components/ArticleArt.astro';
import BlossomScene from '../components/BlossomScene.astro';
import CornerCard from '../components/CornerCard.astro';
import PostList from '../components/PostList.astro';
import Site from '../layouts/Site.astro';
import SocialMarquee from '../components/SocialMarquee.astro';
import { shareImageSize, site } from '../site.config';
import { withBase } from '../utils/paths';
import { getPosts, postHref, readingMinutes, shortDate } from '../utils/posts';

const posts = await getPosts();
const [featured] = posts;
const [firstName, ...lastNames] = site.title.split(' ');
const image = {
  ...shareImageSize,
  path: withBase('og.png'),
  alt: `${site.title}, com flores de cerejeira em ASCII`,
};
---

<Site {image}>
  <div class="home">
    <section class="lead" aria-labelledby="intro-title">
      <div class="intro">
        <h1 id="intro-title">{firstName} <span>{lastNames.join(' ')}</span></h1>
        <p>{site.description}</p>
        <div class="intro-links">
          <a href={withBase('about/')}>Sobre a Clara</a>
        </div>
      </div>
      <BlossomScene />
    </section>

    <SocialMarquee />

    {featured && (
      <div class="bento">
        <CornerCard class="recent-posts" href={withBase('blog/')} label="Todos os textos" aria-labelledby="latest-posts">
          <h2 id="latest-posts">Publicações recentes</h2>
          <PostList posts={posts.slice(0, 3)} compact />
        </CornerCard>

        <a class="featured-story" href={postHref(featured)}>
          <ArticleArt title={featured.data.title} as="h2" topic={featured.data.tags[0]} />
          <div class="featured-copy">
            <p class="story-meta"><time datetime={featured.data.pubDate.toISOString()}>{shortDate(featured.data.pubDate)}</time> · {readingMinutes(featured.body)} min</p>
            <p>{featured.data.description}</p>
          </div>
        </a>
      </div>
    )}
  </div>
</Site>

<style>
  .home { padding-top: 35px; }
  .lead {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    gap: 20px;
    min-block-size: clamp(300px, 31vw, 422px);
    margin-block-end: 36px;
  }
  .lead h1 {
    font: 400 clamp(2.7rem, 6.1vw, 4.65rem)/1 Italiana, var(--serif);
    letter-spacing: -.04em;
    text-wrap: initial;
  }
  .lead h1 span { color: var(--accent); display: inline-block; }
  .lead p { margin-top: 14px; max-width: 42ch; font-size: 1.125rem; line-height: 1.55; }
  .lead > :global(.blossom-scene) { justify-self: center; width: min(100%, 480px); }
  .intro-links { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 4px; }
  .intro-links a { display: inline-flex; align-items: center; min-height: 44px; font-size: var(--text-supporting); }
  .bento { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .recent-posts h2 { margin-block-end: 12px; font-size: 1.125rem; }
  .featured-story {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 18px;
    text-decoration: none;
  }
  .featured-story:hover { border-color: var(--accent); }
  .featured-copy { padding: 12px 20px 16px; font-size: 1rem; line-height: 1.5; color: var(--body); }
  .story-meta { color: var(--muted); font-size: var(--text-caption); margin-bottom: 6px; }
  @media (max-width: 660px) {
    .home { padding-top: 28px; }
    .lead, .bento { grid-template-columns: minmax(0, 1fr); }
    .lead { gap: 12px; min-block-size: 0; margin-block-end: 24px; }
    .lead > :global(.blossom-scene) { width: min(100%, 340px); }
    .lead p { margin-top: 12px; }
  }
</style>
